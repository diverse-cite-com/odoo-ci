ARG ODOO_VERSION=18.0
ARG REGISTRY=registry.bemade.org:443
# For production: leave BASE_IMAGE empty to use official odoo image
# For CI: set BASE_IMAGE_TAG to bemade/docker-odoo-enterprise/odoo-community-ci:18.0
ARG BASE_IMAGE_TAG=
FROM ${BASE_IMAGE_TAG:-odoo:${ODOO_VERSION}}

USER 0

# Install build dependencies required for pycairo/rlPyCairo
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-dev \
      libcairo2-dev \
      pkg-config \
      build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy package list files
COPY build-packages.txt runtime-packages.txt /tmp/

# Install additional build/runtime packages if any are specified
RUN BUILD_PKGS=$(cat /tmp/build-packages.txt 2>/dev/null | tr '\n' ' ') \
    && RUNTIME_PKGS=$(cat /tmp/runtime-packages.txt 2>/dev/null | tr '\n' ' ') \
    && if [ -n "$BUILD_PKGS" ] || [ -n "$RUNTIME_PKGS" ]; then \
         apt-get update && apt-get install -y --no-install-recommends \
           $BUILD_PKGS \
           $RUNTIME_PKGS \
         && rm -rf /var/lib/apt/lists/*; \
       fi \
    && rm -f /tmp/build-packages.txt /tmp/runtime-packages.txt

# Install uv for faster package management
RUN pip install --break-system-packages uv
RUN uv pip install --system --break-system-packages rlPyCairo pdfminer.six

# Copy addons (no chown needed - CI runs as root, production odoo image handles permissions)
COPY ./addons /mnt/extra-addons
COPY requirements.txt /mnt/extra-addons/

# Install requirements from file if present
RUN if [ -f /mnt/extra-addons/requirements.txt ]; then \
      uv pip install --system --break-system-packages --reinstall typing-extensions -r /mnt/extra-addons/requirements.txt; \
    fi