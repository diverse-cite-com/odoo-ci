ARG ODOO_VERSION=18.0
ARG REGISTRY=registry.bemade.org:443
# For production: odoo-community-19.0:latest
# For CI: odoo-community-ci:19.0
ARG BASE_IMAGE_TAG=odoo-community-${ODOO_VERSION}:latest
FROM ${REGISTRY}/bemade/docker-odoo-enterprise/${BASE_IMAGE_TAG}

USER 0

# Install build dependencies required for pycairo/rlPyCairo
RUN apt-get update && apt-get install -y --no-install-recommends \
  python3-dev \
  libcairo2-dev \
  pkg-config \
  build-essential \
  && rm -rf /var/lib/apt/lists/*

# Copy package list files
COPY build-packages.txt runtime-packages.txt /tmp/

# Install additional build/runtime packages if any are specified
RUN BUILD_PKGS=$(cat /tmp/build-packages.txt 2>/dev/null | tr '\n' ' ') \
  && RUNTIME_PKGS=$(cat /tmp/runtime-packages.txt 2>/dev/null | tr '\n' ' ') \
  && if [ -n "$BUILD_PKGS" ] || [ -n "$RUNTIME_PKGS" ]; then \
  apt-get update && apt-get install -y --no-install-recommends \
  $BUILD_PKGS \
  $RUNTIME_PKGS \
  && rm -rf /var/lib/apt/lists/*; \
  fi \
  && rm -f /tmp/build-packages.txt /tmp/runtime-packages.txt

# Install uv for faster package management (to venv if CI image, else system)
RUN if [ -x /opt/odoo-venv/bin/pip ]; then \
  /opt/odoo-venv/bin/pip install uv; \
  else \
  pip install --break-system-packages uv; \
  fi

# Copy addons
COPY ./addons /mnt/extra-addons
COPY requirements.txt /mnt/extra-addons/

# Install requirements from file if present
# Use uv with venv for CI images, system for production
RUN if [ -f /mnt/extra-addons/requirements.txt ]; then \
  if [ -x /opt/odoo-venv/bin/python ]; then \
  uv pip install --python /opt/odoo-venv/bin/python -r /mnt/extra-addons/requirements.txt; \
  else \
  uv pip install --system --break-system-packages -r /mnt/extra-addons/requirements.txt; \
  fi \
  fi